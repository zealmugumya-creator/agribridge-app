# AgriBridge — environment variables (NAMES ONLY, never commit real values).
# Backend reads these from the process environment (Render → Environment).
# Copy to `.env` for local development; `.env` must be git-ignored.

# ── Core / Flask ──────────────────────────────────────────────────────────────
FLASK_ENV=production                 # "development" enables Flask debug/reloader
PORT=5000                            # Render injects this automatically
PUBLIC_BASE_URL=https://agribrige.com
# REQUIRED in production. If unset the app refuses to mint admin tokens (fail closed).
# Use a long random string, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
JWT_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# SERVICE-ROLE key — backend ONLY. Never place this in web/mobile assets.
SUPABASE_KEY=
# Direct/pooled Postgres connection string, used for atomic RPCs and the real
# health check. Prefer the session pooler (port 5432) for server use.
SUPABASE_DB_URL=

# ── Admin bootstrap (Phase 3) ─────────────────────────────────────────────────
# Legacy shared admin password. Kept only until Supabase-Auth admin identity is
# live; leave empty to disable password admin login (fail closed).
ADMIN_PASSWORD=
# Comma-separated Supabase auth UUIDs granted the super-admin role. Populate by
# reading the verified account's UUID from auth.users — do NOT invent a UUID.
# The privileged migration that assigns the role is run manually with the
# service role; see docs/PLAY_STORE_RELEASE.md and supabase/migrations.
ADMIN_ALLOWED_UUIDS=

# ── Africa's Talking (SMS + USSD) ─────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=*789#
AT_SMS_SENDER=AgriBridge

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Payments (each provider stays OFF until its keys are set) ─────────────────
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
# Optional: on-page card form. Leave FLW_DIRECT_CARD empty to use Flutterwave's
# hosted card page (recommended). Enabling direct card charging sends raw card
# data to this server, which puts it in PCI DSS scope — only enable after your
# Flutterwave account and this deployment are PCI attested.
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
FLW_DIRECT_CARD=
# Pesapal API 3.0. `sandbox` until the account is approved, then `live`.
# The IPN endpoint is registered automatically; pin PESAPAL_IPN_ID only if the
# operator already registered it in the Pesapal dashboard. Pesapal must reach
# the Flask API directly (the static site does not proxy /api), so the default
# callback base is the Render service.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_CALLBACK_BASE_URL=https://agribridge-1-og7a.onrender.com
PESAPAL_IPN_ID=
MTN_MOMO_SUBSCRIPTION_KEY=

# ── Bank transfer (offline, admin-verified) ───────────────────────────────────
# The Bank Transfer option is always offered. A real receiving account is shown
# to buyers ONLY when configured here; otherwise they are routed to official
# support. Format is bank|account name|account number[|branch], semicolon to
# separate multiple accounts. Leave empty to show no account number.
BANK_TRANSFER_ACCOUNTS=

# ── Discord operations feed (Phase 7) ─────────────────────────────────────────
# Webhook URL ONLY from env. Never logged, never committed, never in the client.
DISCORD_WEBHOOK_URL=

# ── Error monitoring (Phase 8) ────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Push notifications / FCM (Phase 6) ────────────────────────────────────────
# Firebase Cloud Messaging service-account JSON (path or inline). Backend only.
FCM_SERVICE_ACCOUNT_PATH=
FCM_CREDENTIALS_JSON=
# Optional: Firebase project id. Defaults to the `project_id` in the service
# account JSON; set only if you need to override it.
FCM_PROJECT_ID=

# ── Order routing / stock policy (Phases 4–5) ─────────────────────────────────
# Minutes after which unconfirmed farmer stock is treated as potentially stale.
STOCK_FRESHNESS_MINUTES=4320
# Seconds a farmer has to respond to an offer before it times out.
OFFER_RESPONSE_SECONDS=900
# Max simultaneous farmers offered the same order (small controlled batch).
OFFER_BATCH_SIZE=1

# ── Privacy / account deletion (Phase 10) ─────────────────────────────────────
# Default OFF: account deletion anonymizes the user's own data (reversible from
# backup) and preserves the financial ledger. Set true ONLY after a fresh backup,
# an FK ON DELETE review, and explicit approval — it makes the GoTrue auth-user
# purge irreversible (mandate Rule 8).
ACCOUNT_HARD_DELETE_ENABLED=false

# ── Backups (GitHub Actions secrets, not app env) ─────────────────────────────
# SUPABASE_DB_URL=
# BACKUP_PASSPHRASE=

# ── Legal & consent (migration 0007) ─────────────────────────────────────────
# When true, creating orders/requests and accepting offers is refused until the
# user accepted the current required terms. Enable ONLY after 0007 is applied
# and the updated web app is deployed, or users cannot order.
ENFORCE_LEGAL_ACCEPTANCE=false

# ── Web Push for the website / Android notification bar ───────────────────────
# Generate once (no install needed): python scripts/gen_vapid_keys.py
# Public key is served to browsers; private key stays on the server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services, e.g. mailto:<your official email>. Defaults to the API URL.
VAPID_SUBJECT=
